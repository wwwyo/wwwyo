---
import { Image } from "astro:assets";
import Base from "../../../layouts/Base.astro";
import { projects } from "../../../data/projects";
import { getOgp } from "../../../lib/ogp";

export function getStaticPaths() {
  // The product homepage owns the static skillctrl route.
  return projects.filter((project) => project.slug !== "skillctrl").map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
// 説明文中の URL をリンクにする。split に capture group を渡すと、奇数番目が URL になる。
// 日本語の括弧・句読点は URL に含めない
const paragraphs = project.description
  .split("\n")
  .map((paragraph) => paragraph.split(/(https?:\/\/[^\s（）()「」、。]+)/));
const ogp = project.externalUrl ? await getOgp(project.externalUrl) : null;
---

<Base title={project.title} description={project.summary}>
  <article>
    <header class="post-header">
      <h1>{project.title}</h1>
      <p class="project-period">
        {project.period}
        {project.stopped && <span class="project-stopped">（停止中）</span>}
      </p>
      {
        ogp && (
          <a class="ogp-card" href={ogp.url} target="_blank" rel="noopener noreferrer">
            <span class="ogp-body">
              <span class="ogp-title">{ogp.title}</span>
              {ogp.description && <span class="ogp-description">{ogp.description}</span>}
              <span class="ogp-site">{ogp.siteName}</span>
            </span>
            {ogp.image && (
              <img
                class="ogp-image"
                src={ogp.image.src}
                width={ogp.image.width}
                height={ogp.image.height}
                alt=""
                loading="lazy"
                decoding="async"
              />
            )}
          </a>
        )
      }
      {
        project.achievement && (
          <p class="project-achievement">
            🏆{" "}
            {project.achievement.url ? (
              <a href={project.achievement.url} target="_blank" rel="noopener noreferrer">
                {project.achievement.label}
              </a>
            ) : (
              project.achievement.label
            )}
          </p>
        )
      }
    </header>

    {project.media && (
    <div class="project-media">
      {
        project.media?.type === "images" &&
          project.media.images.map((image) => (
            <Image src={image} alt="" width={960} />
          ))
      }
      {
        project.media?.type === "video" && (
          <video
            src={project.media.src}
            poster={project.media.poster.src}
            autoplay
            loop
            muted
            playsinline
            controls
          />
        )
      }
      {
        project.media?.type === "youtube" && (
          <div class="video-embed">
            <iframe
              src={`https://www.youtube-nocookie.com/embed/${project.media.videoId}${project.media.start ? `?start=${project.media.start}` : ""}`}
              title={project.title}
              loading="lazy"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
            />
          </div>
        )
      }
    </div>
    )}

    <div class="project-description">
      {
        paragraphs.map((parts) => (
          <p>
            {parts.map((part, i) =>
              i % 2 === 1 ? (
                <a href={part} target="_blank" rel="noopener noreferrer">
                  {part}
                </a>
              ) : (
                part
              ),
            )}
          </p>
        ))
      }
    </div>

    {
      project.demoVideo && (
        <div class="project-demo">
          <h2>Demo</h2>
          <video src={project.demoVideo.src} controls playsinline preload="metadata" />
        </div>
      )
    }
  </article>
</Base>

<style>
  .post-header {
    margin: var(--spacing-md) 0 var(--spacing-lg);
  }

  .post-header h1 {
    margin: 0 0 var(--spacing-xs);
  }

  .project-period {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--font-size-mono);
    color: var(--muted-foreground);
  }

  .project-stopped {
    color: var(--muted-foreground);
  }

  .project-media {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
    margin-bottom: var(--spacing-lg);
  }

  .project-media img,
  .project-media video {
    width: 100%;
    height: auto;
    border-radius: var(--rounded-code);
  }

  .video-embed {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
  }

  .video-embed iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: none;
    border-radius: var(--rounded-code);
  }

  .project-description p {
    margin: 0 0 var(--spacing-md);
  }

  .project-demo {
    margin-top: var(--spacing-lg);
  }

  .project-demo video {
    width: 100%;
    height: auto;
    border-radius: var(--rounded-code);
  }

  .project-achievement {
    margin: var(--spacing-sm) 0 0;
  }

  .ogp-card {
    display: flex;
    margin: var(--spacing-sm) 0 0;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--rounded-code);
    color: inherit;
    text-decoration: none;
  }

  .ogp-card:hover {
    background-color: var(--muted);
  }

  .ogp-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: var(--spacing-xs);
    min-width: 0;
    padding: var(--spacing-sm) var(--spacing-md);
  }

  .ogp-title {
    font-weight: 600;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .ogp-description {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    font-size: 0.875em;
    color: var(--muted-foreground);
  }

  .ogp-site {
    margin-top: auto;
    font-family: var(--font-mono);
    font-size: var(--font-size-mono);
    color: var(--muted-foreground);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .ogp-image {
    flex-shrink: 0;
    width: 30%;
    max-width: 240px;
    height: auto;
    aspect-ratio: 1.91 / 1;
    object-fit: cover;
    border-left: 1px solid var(--border);
  }

  @media (max-width: 480px) {
    .ogp-image {
      display: none;
    }
  }
</style>
